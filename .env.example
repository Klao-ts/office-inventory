# Supabase — get these from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: low-stock email notifications (Resend)
RESEND_API_KEY=your-resend-api-key
LOW_STOCK_ALERT_EMAIL=admin@yourcompany.com
